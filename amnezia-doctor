fi

# Цветная плашка во всю ширину окна: фон тянется до края через «стереть до конца строки»
bar() {  # фон текст
  if [ -n "$1" ]; then printf '%s%s%s%s\n' "$1" "$2" "$T_EOL" "$T_RST"
  else printf '%s\n' "${2:-━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━}"; fi
}

show_verdict() {
  local bg icon big sub
  case "$VERDICT_STATUS" in
    FAIL) bg="$T_BG_FAIL"; icon="❌"; big="НЕ РАБОТАЕТ";                  sub="$VERDICT_TITLE" ;;
    WARN) bg="$T_BG_WARN"; icon="⚠️ "; big="РАБОТАЕТ, НО ЕСТЬ ЗАМЕЧАНИЯ"; sub="$VERDICT_TITLE" ;;
    *)    bg="$T_BG_OK";   icon="✅"; big="ВСЁ РАБОТАЕТ";                 sub="Проблем не найдено" ;;
  esac
  {
    printf '\n'
    bar "$bg" ""
    bar "$bg" "$T_B   $icon  $big"
    bar "$bg" "       $sub"
    bar "$bg" ""
    printf '\n'
    if [ "$VERDICT_STATUS" != OK ] && [ -n "$VERDICT_REC" ]; then
      printf '%s👉 Что сделать:%s %s\n\n' "$T_B" "$T_RST" "$VERDICT_REC"
    fi
    printf '%sПроверки:%s\n' "$T_B" "$T_RST"
    awk -F'\t' -v ok="$T_OK" -v wa="$T_WARN" -v fa="$T_FAIL" -v in_="$T_INFO" -v r="$T_RST" '{
      if ($1 == "FAIL")      { e = "❌"; c = fa }
      else if ($1 == "WARN") { e = "⚠️ "; c = wa }
      else if ($1 == "INFO") { e = "ℹ️ "; c = in_ }
      else                   { e = "✅"; c = ok }
      printf "  %s %s%s%s\n", e, c, $3, r
    }' "$FIND"
  } >&2
}


