# страны, где Codex (OpenAI) и Claude (Anthropic) недоступны
AI_BLOCKED=" RU BY CN HK IR KP CU SY VE AF "

ai_reach() {  # codex|claude → "ok IP СТРАНА" или текст причины
  local host api trace ip loc code
  case "$1" in
    codex)  host=chatgpt.com; api=https://api.openai.com/v1/models ;;
    claude) host=claude.ai;   api=https://api.anthropic.com/v1/messages ;;
  esac
  code="$(http_code "$api")"
  if [ "$code" = 000 ]; then printf 'нет связи с %s — интернета нет или VPN не подключён' "${api%%/v1*}"; return 1; fi
  trace="$(to 12 curl -s -m 8 "https://$host/cdn-cgi/trace" 2>/dev/null)"
  ip="$(printf '%s\n' "$trace" | sed -n 's/^ip=//p')"
  loc="$(printf '%s\n' "$trace" | sed -n 's/^loc=//p')"
  case "$AI_BLOCKED" in *" $loc "*) printf 'выход в интернет через %s (%s) — оттуда %s недоступен; нужен VPN в другую страну' "$loc" "$ip" "$host"; return 1 ;; esac
  if [ "$code" = 403 ]; then printf '%s отвечает «доступ запрещён» (403) — смените страну VPN' "${api%%/v1*}"; return 1; fi
  printf 'ok %s %s' "$ip" "${loc:-?}"
}

ai_fix() {  # codex|claude
  local tool="$1" name r key
  case "$tool" in codex) name="Codex" ;; claude) name="Claude Code" ;; esac
  if ! command -v "$tool" >/dev/null 2>&1; then
    say ""
    say "🤖 $name не установлен на этом Mac. Установка (нужен рабочий интернет):"
    case "$tool" in
      codex)  say "   npm install -g @openai/codex   — или: brew install codex" ;;
      claude) say "   curl -fsSL https://claude.ai/install.sh | bash" ;;
    esac
    say "Затем запустите $tool в папке с результатами: cd \"$OUT\" && $tool \"\$(cat AI_PROMPT.md)\""
    return 0
  fi
  {
    printf '\n'
    bar "$T_BG_WARN" ""
    bar "$T_BG_WARN" "$T_B   ⚠️   ВКЛЮЧИТЕ ЗАПАСНОЙ VPN"
    bar "$T_BG_WARN" "       $name работает через интернет, а через Amnezia связи сейчас может не быть"
    bar "$T_BG_WARN" ""
    printf '\n  1. Отключите VPN в Amnezia.\n  2. Включите любой другой работающий VPN.\n  3. Нажмите Enter — я проверю, что связь с %s есть.  (q — отмена)\n' "$name"
  } >&2
  while :; do
    printf '\n> ' >&2
    IFS= read -r key < /dev/tty || return 0
    case "$key" in q|Q|й|Й) say "Отменено. Промпт для ИИ лежит в $OUT/AI_PROMPT.md"; return 0 ;; esac
    say "🔍 Проверяю связь с $name…"
    if r="$(ai_reach "$tool")"; then
      set -- $r
      say "${T_OK}✅ Запасной VPN работает: выход через $2 ($3), $name доступен.${T_RST}"
      break
    fi
    say "${T_FAIL}❌ $r.${T_RST}"
    say "Проверьте запасной VPN и нажмите Enter ещё раз (q — отмена)."
  done
  say ""
  say "🤖 Запускаю $name с задачей на исправление. Папка с результатами: $OUT"
  say ""
  cd "$OUT" || return 1
  "$tool" "$(cat AI_PROMPT.md)" < /dev/tty > /dev/tty 2>&1
}

# ================================================================ передача архива дальше

# file:// ссылка: Терминал и iTerm открывают её по ⌘+клику
file_url() { perl -e '(my $p = $ARGV[0]) =~ s{([^A-Za-z0-9\-._~/])}{sprintf("%%%02X", ord $1)}ge; print "file://$p"' "$1"; }

app_path() {  # первое найденное приложение из списка имён
  local n
  for n in "$@"; do
    [ -d "/Applications/$n.app" ] && { printf '/Applications/%s.app' "$n"; return 0; }
    [ -d "$HOME/Applications/$n.app" ] && { printf '%s/Applications/%s.app' "$HOME" "$n"; return 0; }
    [ -d "/System/Applications/$n.app" ] && { printf '/System/Applications/%s.app' "$n"; return 0; }
  done
  return 1
}

copy_file() {  # путь → буфер обмена как файл (public.file-url), вставляется ⌘V вложением
  osascript -l JavaScript -e 'function run(a) { ObjC.import("AppKit"); var pb = $.NSPasteboard.generalPasteboard;
    pb.clearContents; return pb.writeObjects($([$.NSURL.fileURLWithPath(a[0])])) }' "$1" 2>/dev/null | grep -q true
}

share_menu() {  # архив
  local zip="$1" tg mail key i=0 acts="" def=""
  { : < /dev/tty; } 2>/dev/null || return 0
  tg="$(app_path Telegram "Telegram Desktop")"
  mail="$(app_path Mail)"
  [ "$VERDICT_STATUS" != OK ] && def=codex
  {
    printf '\n%sЧто дальше?%s\n' "$T_B" "$T_RST"
    i=$((i + 1)); acts="$acts codex"
    printf '  %s) 🤖 Починить с помощью Codex%s\n' "$i" "$([ "$def" = codex ] && printf ' ← Enter')"
    i=$((i + 1)); acts="$acts claude"; printf '  %s) 🤖 Починить с помощью Claude Code\n' "$i"
    if [ -n "$tg" ]; then i=$((i + 1)); acts="$acts tg"; printf '  %s) 💬 Telegram — откроется Telegram, архив будет в буфере: выберите чат и ⌘V\n' "$i"; fi
    if [ -n "$mail" ]; then i=$((i + 1)); acts="$acts mail"; printf '  %s) ✉️  Почта — новое письмо с архивом во вложении\n' "$i"; fi
    i=$((i + 1)); acts="$acts clip"; printf '  %s) 📋 Скопировать архив — вставьте ⌘V в любой мессенджер (WhatsApp, Telegram, Slack…)\n' "$i"
    i=$((i + 1)); acts="$acts finder"; printf '  %s) 📂 Показать в Finder — перетащите архив куда нужно\n' "$i"
    printf '  0) выход%s\n\n' "$([ -z "$def" ] && printf ' ← Enter')"
    printf 'Выбор: '
  } >&2
  IFS= read -r -t 300 key < /dev/tty || key=0
  if [ -z "$key" ]; then
    [ -n "$def" ] && { ai_fix "$def"; return; }
    key=0
  fi
  case "$key" in 0) say "Готово. Архив лежит на месте."; return 0 ;; *[!0-9]*) say "Нет такого пункта. Архив лежит на месте."; return 0 ;; esac
  set -- $acts
  [ "$key" -ge 1 ] && [ "$key" -le $# ] || { say "Нет такого пункта. Архив лежит на месте."; return 0; }
  eval "key=\${$key}"
  case "$key" in
    codex|claude) ai_fix "$key" ;;
    # Telegram для macOS не принимает файлы через «открыть в программе» — передаём через буфер
    tg)     if copy_file "$zip"; then open -a "$tg"; say "💬 Telegram открыт, архив в буфере обмена: откройте нужный чат и нажмите ⌘V, затем Enter."
            else open -R "$zip"; open -a "$tg"; say "Не удалось скопировать — открыл Finder и Telegram: перетащите архив в чат."; fi ;;
    mail)   open -a "$mail" "$zip" && say "✉️  Письмо создано: впишите адрес и нажмите «Отправить»." ;;
    clip)   if copy_file "$zip"; then say "📋 Архив скопирован. Откройте нужный чат и нажмите ⌘V."
            else open -R "$zip"; say "Скопировать не удалось — открыл Finder, перетащите архив."; fi ;;
    finder) open -R "$zip" && say "📂 Архив выделен в Finder." ;;
  esac
}

normalize_facts() {
  # первое значение ключа побеждает; сортировка — для стабильности отчёта
  awk '{ k = $0; sub(/=.*/, "", k); if (!(k in s)) { s[k] = 1; print } }' "$FACTS" | LC_ALL=C sort > "$FACTS.tmp" && mv "$FACTS.tmp" "$FACTS"
}

